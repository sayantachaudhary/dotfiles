#!/bin/sh

menu=$(command -v rofi >/dev/null 2>&1 && echo "rofi -dmenu -i" || echo "dmenu -i")
if command -v fd >/dev/null 2>&1; then
	file=$(fd -e pdf . "$HOME")
else
	file=$(find "$HOME" -maxdepth 10 -type f -name "*.pdf" -not -path '*/\.*' 2>/dev/null)
fi

[ -n "$file" ] || exit

chosen_file=$(echo "$file" | eval "$menu -p 'Choose PDF:'")
if [ -n "$chosen_file" ]; then
	zathura "$chosen_file" 2>/dev/null &
fi
